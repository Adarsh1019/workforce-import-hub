# Frontend: public API origin, embedded into the browser bundle at build time.
VITE_API_URL=https://your-backend.onrender.com/api

# Backend only: set these in the Render backend service, not in the frontend.
SPRING_PROFILES_ACTIVE=production
DB_URL=jdbc:postgresql://your-internal-host:5432/your_database?sslmode=require
DB_USER=your_database_user
DB_PASSWORD=replace-with-render-database-password
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
CORS_ORIGINS=https://your-frontend.onrender.com
UPLOAD_DIR=/data/uploads
# Optional one-time account creation: set true and supply unique temporary secrets,
# then set false and remove the four credential variables after the first deploy.
BOOTSTRAP_USERS_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=replace-with-admin-username
BOOTSTRAP_ADMIN_PASSWORD=replace-with-unique-password-at-least-12-characters
BOOTSTRAP_HR_USERNAME=replace-with-hr-username
BOOTSTRAP_HR_PASSWORD=replace-with-unique-password-at-least-12-characters